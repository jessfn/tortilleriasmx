# Copiar a /var/www/Tortillerias/.env en el servidor de la Secretaría y dejar permiso 600 (chmod 600 .env).
# NUNCA subir el .env a Git. Aquí solo van los NOMBRES; los valores se capturan en el servidor.

# Base de datos nueva en el RDS (la crea infraestructura). El RDS no se verifica con la CA de Node: se usa sslmode=no-verify
# (los scripts de psql lo convierten solos a sslmode=require).
DATABASE_URL=postgresql://USUARIO_TORTILLERIAS:CONTRASENA@HOST_RDS:5432/tortillerias?sslmode=no-verify

# DEBE SER LA MISMA llave del servidor anterior: con ella se cifran el RFC y el celular de las tortillerías y se buscan por hash.
# Si se cambia, esos datos ya guardados no se pueden leer. Se copia directo del .env anterior (64 caracteres hexadecimales).
ENCRYPTION_KEY=

# Este sí se genera nuevo (mínimo 32 caracteres; p. ej. `openssl rand -hex 48`). Al cambiarlo, todos tendrán que iniciar sesión otra vez.
JWT_SECRET=

# Dominio nuevo y, mientras dure la transición, el anterior (separados por coma). Después se deja solo el nuevo.
CORS_ORIGIN=https://tortilleriasmx.agricultura.gob.mx,https://tortilleriasmx.geodatos.com.mx

# Puerto asignado por infraestructura (el 3007 queda reservado)
PORT=3006

# Proxies delante de la app: balanceador (ELB) + nginx = 2. Sirve para contar el límite de peticiones por cliente real.
TRUST_PROXY=2

# Fotos de las tortillerías nuevas (privadas: solo las entrega la API con sesión; nginx NO debe servir esta carpeta)
UPLOADS_DIR=/var/www/Tortillerias/datos/fotos

NODE_ENV=production
